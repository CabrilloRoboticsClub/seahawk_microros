{
    "cmake.configureEnvironment": {
        "PICO_SDK_PATH": "${workspaceFolder}/src/pico-sdk",
        "MICRO_ROS_RPI_PICO_PATH": "${workspaceFolder}/src/micro_ros_raspberrypi_pico_sdk",
    },
    "git.detectSubmodules": false,
    "cmake.sourceDirectory": "${workspaceFolder}/src/seahawk",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.cStandard": "gnu11",
    "C_Cpp.default.cppStandard": "c++17",
    "files.associations": {
        "stdio.h": "c",
        "rmw_microros.h": "c",
        "int32.h": "c",
        "int16_multi_array.h": "c"
    },
    "ROS2.distro": "lyrical",
    "python.autoComplete.extraPaths": [
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
}
